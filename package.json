{
  "name": "godot-kirie",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm -rF \"./packages/*\" run build",
    "format:eslint": "eslint . --fix",
    "lint:alint": "alint",
    "lint:eslint": "eslint .",
    "release": "bumpp",
    "test:swift": "./scripts/run-build-task.js testSwift",
    "test:unit": "pnpm -rF \"./packages/*\" run test:run",
    "typecheck": "pnpm -rF \"./packages/*\" run typecheck"
  },
  "devDependencies": {
    "@alint-js/cli": "catalog:",
    "@antfu/eslint-config": "catalog:",
    "@gd-kirie/alint-config": "workspace:*",
    "bumpp": "catalog:",
    "execa": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "kirie": "workspace:*"
  }
}
