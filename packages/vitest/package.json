{
  "name": "@gd-kirie/vitest",
  "version": "0.8.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/moeru-ai/godot-kirie.git",
    "directory": "packages/vitest"
  },
  "bin": {
    "kirie-vitest": "./src/launcher.ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vidot/vitest": "^0.2.0",
    "execa": "catalog:",
    "kirie": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "bin": {
      "kirie-vitest": "./dist/launcher.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
