{
  "name": "kirie",
  "version": "0.11.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/moeru-ai/godot-kirie.git",
    "directory": "packages/cli"
  },
  "bin": {
    "kirie": "./kirie.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./plugin/core": {
      "import": "./src/plugin/core.ts"
    },
    "./plugin": {
      "import": "./src/plugin/index.ts"
    }
  },
  "files": [
    "addon",
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/package-addon.ts",
    "test:run": "vitest run --no-file-parallelism --test-timeout 30000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gd-kirie/build": "workspace:*",
    "citty": "catalog:",
    "execa": "catalog:",
    "giget": "3.3.0",
    "takanawa-node": "0.9.0",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@gd-kirie/kirie": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./plugin/core": {
        "types": "./dist/plugin/core.d.ts",
        "import": "./dist/plugin/core.js"
      },
      "./plugin": {
        "types": "./dist/plugin/index.d.ts",
        "import": "./dist/plugin/index.js"
      }
    }
  }
}
