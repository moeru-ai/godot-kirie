<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>GdKirie.Tray</PackageId>
    <Version>0.10.0</Version>
    <Authors>Moeru AI</Authors>
    <Description>System tray integration for Godot applications using Kirie Eventa IPC.</Description>
    <PackageTags>godot;kirie;eventa;tray;menu;status-item</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/moeru-ai/godot-kirie</PackageProjectUrl>
    <RepositoryUrl>https://github.com/moeru-ai/godot-kirie</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>bin/$(Configuration)</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GdKirie.EventaAdapter/GdKirie.EventaAdapter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
