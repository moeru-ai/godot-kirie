config_version=5

[application]

config/name="Kirie Basic Platform"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

window/size/viewport_width=1630
window/size/viewport_height=1330

[dotnet]

project/assembly_name="KirieBasicPlatform"

[editor_plugins]

enabled=PackedStringArray("res://addons/kirie/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
