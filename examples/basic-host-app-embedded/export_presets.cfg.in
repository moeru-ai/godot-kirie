[preset.0]

name="iOS Embed Debug"
platform="iOS"
runnable=true
advanced_options=true
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter="src-web/index.html,src-web/src/*,src-web/node_modules/*,src-web/package.json,src-web/tsconfig.json,src-web/vite.config.ts,android-host/*,ios-host/*"
export_path=""
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

custom_template/debug="@TEMPLATE@"
custom_template/release=""
architectures/arm64=true
application/app_store_team_id="@TEAM@"
application/export_method_debug=1
application/code_sign_identity_debug=""
application/export_method_release=0
application/bundle_identifier="@BUNDLE@"
application/export_project_only=true
application/delete_old_export_files_unconditionally=true
application/targeted_device_family=2
application/min_ios_version="14.0"
application/additional_plist_content="<key>NSAppTransportSecurity</key>\n<dict>\n    <key>NSAllowsArbitraryLoadsInWebContent</key>\n    <true/>\n    <key>NSAllowsLocalNetworking</key>\n    <true/>\n</dict>\n<key>NSLocalNetworkUsageDescription</key>\n<string>Connect to the local Kirie development server for live preview.</string>"
modules/camera=false
shader_baker/enabled=false
dotnet/include_scripts_content=false
dotnet/include_debug_symbols=true
dotnet/embed_build_outputs=false
kirie/debug/enable_web_inspector=true
kirie/debug/allow_tls_bypass=false

[preset.1]

name="Android Embed Debug"
platform="Android"
runnable=true
advanced_options=true
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter="src-web/index.html,src-web/src/*,src-web/node_modules/*,src-web/package.json,src-web/tsconfig.json,src-web/vite.config.ts,android-host/*,ios-host/*"
export_path=""
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.1.options]

custom_template/debug=""
custom_template/release=""
gradle_build/use_gradle_build=true
gradle_build/gradle_build_directory="res://android"
gradle_build/android_source_template="@ANDROID_SOURCE_TEMPLATE@"
gradle_build/compress_native_libraries=false
gradle_build/export_format=0
architectures/armeabi-v7a=false
architectures/arm64-v8a=true
architectures/x86=false
architectures/x86_64=false
package/unique_name="@ANDROID_PACKAGE@"
package/name="View Embedded"
package/signed=true
package/app_category=2
screen/immersive_mode=false
screen/edge_to_edge=false
screen/support_small=true
screen/support_normal=true
screen/support_large=true
screen/support_xlarge=true
screen/background_color=Color(0, 0, 0, 1)
screen/orientation=1
shader_baker/enabled=false
dotnet/android_use_linux_bionic=false
dotnet/include_scripts_content=false
dotnet/include_debug_symbols=true
dotnet/embed_build_outputs=false
kirie/debug/enable_web_inspector=true
kirie/debug/allow_tls_bypass=false
permissions/internet=true
