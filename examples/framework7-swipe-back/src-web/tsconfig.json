{
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "framework7/lite/bundle": ["./src/types/framework7-core.d.ts"],
      "framework7-vue": ["./src/types/framework7-vue.d.ts"]
    },
    "strict": true,
    "target": "ESNext",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
