{
  "name": "@gd-kirie/basic-kirie-cli",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:godot && kirie build",
    "build:godot": "tstogd convert",
    "dev": "pnpm run build:godot && kirie dev",
    "generate:godot": "tstogd convert --no-check",
    "typecheck": "pnpm run build:godot && tsc -p src-web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gd-kirie/ipc": "workspace:*"
  },
  "devDependencies": {
    "kirie": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "typescript-to-gdscript": "0.1.2",
    "vite": "catalog:"
  }
}
