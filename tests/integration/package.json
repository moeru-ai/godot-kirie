{
  "name": "@gd-kirie/integration-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "build:godot": "tstogd convert src/integration_probe.ts src/mobile_test_runner.ts --project-root . --tsconfig tsconfig.godot.json --no-check",
