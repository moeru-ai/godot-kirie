  },
  "devDependencies": {
    "@gd-kirie/vitest": "workspace:*",
    "@types/node": "catalog:",
    "@vidot/vitest": "^0.2.0",
    "typescript": "catalog:",
    "typescript-to-gdscript": "catalog:",
    "vitest": "catalog:"
  }
}
